# Python / test cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
.venv-win/
venv/
env/

# Runtime data
# 整個 data/ 都忽略，不要只擋 *.db：手動備份常常叫 fee_control.db.backup-YYYYMMDD、
# .unused-… 這種名字，副檔名不是 .db 就漏掉了，而那裡面是公司真實資料。
# （2026-08-12 差點把兩個備份 commit 進 public repo，靠 pre-commit 擋下來。）
data/
data/*.db
data/*.sqlite
data/*.sqlite3
data/reset_backups/

# 更新器（downloadpatch.bat）在部署擺法下會把 helper 腳本複製到專案根目錄。
# 正本在 notebook-package/，根目錄這幾份是執行產物，不該回頭進版控。
/service.bat
/service.ps1
/download.bat
/update.bat
logs/
*.log

# C1 生成物（由 snapshot.py 產生，不進版控）
CURRENT_STATE.md

# C1 會議 demo 稿（內含示範用假密鑰，是給人看的 meeting 稿，不進版控）
DEMO_會議腳本.md

# Local environment / secrets
.env
.env.*
!.env.example

# OneDrive / Windows noise
desktop.ini
Thumbs.db
~$*
*.tmp
*.bak

# Source business documents and sensitive samples.
# Keep derived Markdown notes in docs/, but do not version raw source files by default.
DOC/
*.pdf
*.docx
*.pptx
# 例外：對外簡報成品，跟已版控的 PPT/*.md 文字稿是同一份內容，故意進 git
!PPT/03_AI用法你在第幾代.pptx
*.xlsx
*.xls
*.xlsm
*.csv
*.tsv

# 簡報二進位／圖檔／舊草稿：走 OneDrive，不進 git（只版控 PPT/*.md 文字稿）
PPT/圖/
PPT/_舊版草稿/

# 自主迴圈（.project/loop.py）的揮發產出：報告是生成物、backlog 是執行時佇列
.project/run_report.md
.project/backlog.json

# 只留本機的開發筆記。CL_FEE 是公開 repo，交接摘要屬於內部工作紀錄，
# 不進公開歷史；跨裝置靠 AI_note 私有 repo 同步。
交接摘要_*.md
# 待決策清單同理，而且更敏感：裡面有合約系統、處長決策關卡、金額門檻這類公司內部業務資訊。
待你決定.md
# 寄給主管/助理的信件草稿與週報模板：內容是對外溝通的業務描述（要請誰給什麼資料、
# 組織角色、核決規則），一樣走 AI_note 私有 repo 同步，不進公開 repo。
# 產生它們的工具（scripts/weekly_report_tools.py、.claude/skills/weekly-report）不含業務資訊，正常進版控。
信件_*.md
週報告_TEMPLATE.md
# 業主給的需求文件與逐項對照（含廠商、機房位置、核決規則等公司內部資訊）
*需求對照表.md
docs/0803/

# 外部 skill 壓縮包：跟程式無關，且可能含公司內部素材
*.skill

# notebook-package 的執行期內容：app/ 與 tests/ 由 update.bat 從 GitHub 下載，
# data/ 是本機資料庫、logs/ 是執行紀錄。這些是部署產物，不該回頭進版控，
# 否則會跟來源目錄互相覆蓋。
notebook-package/app/
notebook-package/tests/
notebook-package/data/
notebook-package/logs/
# 每台機器自己指定 Python 位置用的（service.ps1 第 1 層偵測會讀），純本機設定，不進版控
notebook-package/python_path.txt
python_path.txt

# 根目錄舊檔歸檔：git 歷史已保留被刪原檔，備份不重複進版控
archive/

# Archives and generated bundles
*.zip
*.rar
*.7z
# 派送包的改名副本（package_notebook_full.ps1 -ForMail 產生，用來閃過郵件閘道
# 對 .zip 夾帶 .bat 的封鎖）。它就是上面那個 zip，一樣是生成物。
*.rename-to-zip
project-baseline-kit_v*/

# Frontend / package caches if added later
node_modules/
dist/
build/

# 開發進度報告（含內部專案資訊，只留本機、不上公開 repo）
docs/開發進度報告.html
# 同一份報告的 Excel 版（週報第二個附件，內容一樣是內部專案資訊）
docs/開發進度報告_對照表.xlsx

docs/報告存檔/

# 內部需求確認文件（含 drawio 流程圖），不上公開 repo
docs/確認說明書/
